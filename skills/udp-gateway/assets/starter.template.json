{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Starter template for a Proxylity UDP Gateway service with a Lambda destination. Replace the inline handler with your own logic. You must be subscribed to Proxylity UDP Gateway on AWS Marketplace to deploy this template.",

  "Parameters": {
    "ClientCidrToAllow": {
      "Type": "String",
      "MinLength": 1,
      "Description": "Actual public source CIDR of allowed clients, for example 203.0.113.10/32. No public-access default. Omitting ClientRestrictions blocks traffic."
    }
  },

  "Mappings": {
    "ProxylityConfig": {
      "Fn::Transform": {
        "Name": "AWS::Include",
        "Parameters": {
          "Location": {
            "Fn::Sub": "s3://proxylity-config-${AWS::Region}/${AWS::AccountId}/customer-config.json"
          }
        }
      }
    }
  },

  "Resources": {

    "HandlerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      }
    },

    "DeliveryErrorLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      }
    },

    "PacketHandler": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Policies": [{
          "Statement": [{
            "Effect": "Allow",
            "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
            "Resource": { "Fn::GetAtt": ["HandlerLogs", "Arn"] }
          }]
        }],
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "MemorySize": 512,
        "Timeout": 10,
        "LoggingConfig": {
          "LogGroup": { "Ref": "HandlerLogs" }
        },
        "InlineCode": {
          "Fn::Join": ["\n", [
            "exports.handler = async (event) => {",
            "  if (!Array.isArray(event.Messages)) {",
            "    throw new TypeError('Expected UDP Gateway Messages array');",
            "  }",
            "  console.log('Received', event.Messages.length, 'packets');",
            "  return {",
            "    Replies: event.Messages.map(msg => ({ Tag: msg.Tag, Data: msg.Data }))",
            "  };",
            "};"
          ]]
        }
      }
    },

    "DestinationRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": {
              "AWS": {
                "Fn::FindInMap": ["ProxylityConfig", { "Ref": "AWS::Region" }, "ServiceRole"]
              }
            },
            "Action": "sts:AssumeRole"
          }]
        },
        "Policies": [{
          "PolicyName": "AllowLambdaMetricsAndDeliveryLogs",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["lambda:InvokeFunction"],
                "Resource": [{ "Fn::GetAtt": ["PacketHandler", "Arn"] }]
              },
              {
                "Effect": "Allow",
                "Action": ["cloudwatch:PutMetricData"],
                "Resource": "*",
                "Condition": {
                  "StringEquals": {
                    "cloudwatch:namespace": "Proxylity/UDP Gateway"
                  }
                }
              },
              {
                "Effect": "Allow",
                "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                "Resource": { "Fn::GetAtt": ["DeliveryErrorLogs", "Arn"] }
              }
            ]
          }
        }]
      }
    },

    "UdpListener": {
      "Type": "Custom::ProxylityUdpGatewayListener",
      "Properties": {
        "ServiceToken": {
          "Fn::FindInMap": ["ProxylityConfig", { "Ref": "AWS::Region" }, "ServiceToken"]
        },
        "ApiKey": {
          "Fn::FindInMap": ["ProxylityConfig", "Account", "ApiKey"]
        },
        "Protocols": ["udp"],
        "ClientRestrictions": {
          "Networks": [{ "Ref": "ClientCidrToAllow" }]
        },
        "Destinations": [{
          "Description": "Delivers packets to the starter Lambda handler.",
          "DestinationArn": { "Fn::GetAtt": ["PacketHandler", "Arn"] },
          "Role": { "Arn": { "Fn::GetAtt": ["DestinationRole", "Arn"] } },
          "Batching": {
            "Count": 10,
            "TimeoutInSeconds": 0.05
          },
          "Formatter": "base64",
          "MetricsEnabled": true,
          "LogGroupName": { "Ref": "DeliveryErrorLogs" }
        }]
      }
    }

  },

  "Outputs": {
    "Endpoint": {
      "Description": "UDP endpoint to send packets to (domain:port).",
      "Value": { "Fn::Sub": "${UdpListener.Domain}.proxylity.com:${UdpListener.Port}" }
    },
    "Domain": {
      "Description": "Ingress domain for the listener.",
      "Value": { "Fn::Sub": "${UdpListener.Domain}.proxylity.com" }
    },
    "Port": {
      "Description": "UDP port for the listener.",
      "Value": { "Fn::GetAtt": ["UdpListener", "Port"] }
    },
    "LambdaFunction": {
      "Description": "Lambda function ARN.",
      "Value": { "Fn::GetAtt": ["PacketHandler", "Arn"] }
    }
  }
}
